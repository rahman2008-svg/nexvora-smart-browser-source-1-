<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="nx_bg">#070812</color>
    <style name="Theme.NexVora" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nx_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.NexVora.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nx_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.NexVora</item>
    </style>
</resources>
